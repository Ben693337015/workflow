# Copier ce fichier en .env et renseigner les valeurs reelles.
# Ne jamais committer le fichier .env.

# Generer une valeur aleatoire pour chaque secret :
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY et JWT_SECRET_KEY doivent etre DIFFERENTS l'un de l'autre. Ne jamais garder les valeurs d'exemple
# hors d'un poste de developpement.

# --- Application ---
APP_NAME="Plateforme d'approbation de workflows"
ENVIRONMENT=development
SECRET_KEY=change-me-with-a-long-random-value

# Migrations de base au demarrage du conteneur backend (scripts/entrypoint.sh). docker compose le force a true.
# En production avec PLUSIEURS instances : laisser false et lancer `alembic upgrade head` une seule fois.
RUN_MIGRATIONS=false
# Nombre de processus gunicorn (image de production). Par defaut : 4.
# WEB_CONCURRENCY=4

# --- Base de donnees (PostgreSQL sur NubiStack, section 3.3 / 14.1) ---
DATABASE_URL=postgresql+asyncpg://workflows:workflows@db:5432/workflows

# --- JWT (section 5) ---
JWT_SECRET_KEY=change-me-with-another-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=45
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Jetons de decision par e-mail (section 9) ---
# Jeton opaque (secrets.token_urlsafe) + empreinte SHA-256 en base (section 9.3)
# - aucun secret de signature necessaire (ecart corrige du 15/09 : le mecanisme
# utilisait auparavant itsdangerous, explicitement ecarte par le benchmark
# section 9.2 ; DECISION_TOKEN_SECRET n'est donc plus une variable attendue).
DECISION_TOKEN_EXPIRE_HOURS=336

# Rappels automatiques des decisions en attente (CDC fonctionnel 2.4). Une etape en
# attente est relancee toutes les RAPPEL_FREQUENCE_HEURES (0 ou negatif : desactive) ;
# le controle tourne toutes les RAPPEL_VERIFICATION_MINUTES. Plusieurs instances du
# backend peuvent tourner sans doublon (reservation atomique en base).
RAPPELS_AUTOMATIQUES_ACTIFS=true
RAPPEL_FREQUENCE_HEURES=48
RAPPEL_VERIFICATION_MINUTES=15
RAPPEL_LOT_MAX=200
# Option retenue section 9.1 : jeton + session active exigee (Option B)
DECISION_REQUIRES_ACTIVE_SESSION=true

# --- Webhooks sortants (section 10) ---
WEBHOOK_MAX_RETRIES=5
# Cle de chiffrement au repos des secrets d'abonnement webhook (R22). A generer avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Laisse vide : une cle est derivee de SECRET_KEY. ATTENTION : changer cette cle (ou SECRET_KEY si elle
# sert de base) rend illisibles les secrets deja stockes ; il faut alors les regenerer.
WEBHOOK_ENCRYPTION_KEY=

# --- Limitation des connexions echouees (R9, CDC section 5) ---
CONNEXION_MAX_TENTATIVES=5
CONNEXION_DUREE_VERROUILLAGE_MINUTES=15

# --- Service d'e-mails (section 14.2 - Resend retenu) ---
# Vide : en developpement, les e-mails (liens de decision) sont ecrits dans les logs de l API, rien n est envoye.
RESEND_API_KEY=
EMAIL_FROM="Plateforme Workflows <notifications@votre-domaine.tld>"

# URL publique du frontend (utilisee dans les liens de decision envoyes
# par e-mail, section 9 du CDC technique - ex. https://workflows.votre-domaine.tld
# en production). Port 3000 : celui du frontend Next.js (voir
# frontend/Dockerfile), pas 5173 (ancien serveur de developpement Vite,
# retire lors de la migration vers Next.js).
FRONTEND_BASE_URL=http://localhost:3000

# --- Stockage fichiers (pieces jointes, signatures) ---
# DEUX MODES, choisis automatiquement :
#  1) S3 (NubieS3 / Backblaze B2 / tout service S3 compatible) : renseignez LES QUATRE variables S3_ENDPOINT_URL,
#     S3_BUCKET, S3_ACCESS_KEY, S3_SECRET_KEY. Les fichiers vont dans le bucket (PRIVE ; les telechargements passent
#     par l'API authentifiee). Aucun disque a monter. Une configuration INCOMPLETE (1 a 3 variables) empeche le
#     demarrage de l'API, pour ne jamais ecrire en silence sur un disque ephemere.
#  2) Dossier local (STOCKAGE_FICHIERS_DOSSIER) : si AUCUNE variable S3_* n'est renseignee. En Docker, ce dossier est un
#     volume (docker-compose.yml : pieces_jointes) ; en production, montez-le sur un stockage persistant et
#     SAUVEGARDEZ-LE avec la base.
# Quel que soit le mode : 40 Mo maximum par fichier ; un reverse proxy doit accepter au moins 41 Mo (nginx :
# client_max_body_size 41m;).
# Verifier la configuration :  python -m scripts.verifier_stockage
# Passer du disque a S3 :       python -m scripts.migrer_fichiers_vers_s3 --dry-run   (puis sans --dry-run)
STOCKAGE_FICHIERS_DOSSIER=/var/lib/workflows/pieces-jointes
# Exemple NubieS3 (cle creee dans NubieS3 > bucket > Access keys ; le secret n'est affiche qu'a la creation) :
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Optionnel : region (vide = deduite de l'endpoint, ex. eu-central-003) et prefixe dans le bucket (bucket partage).
S3_REGION=
S3_PREFIX=workflows/

# --- Regles metier congés (decisions confirmees) ---
CONGES_REPORT_SOLDE_ILLIMITE=true
CONGES_UNITE_JOUR_ENTIER=true
# Duree d'un conge : jours CALENDAIRES (week-ends inclus) tant que la DRH n'a pas valide une autre regle
# (R20). Passer a true pour ne decompter que du lundi au vendredi. Les jours feries sont retires dans
# les deux cas.
CONGES_EXCLURE_WEEKENDS=false

# --- Regles metier notes de frais ---
# Devise de REFERENCE (enveloppes budgetaires, soldes, seuil ci-dessous). Les autres devises sont converties a
# la soumission. Si vous la changez, adaptez aussi le seuil (500 EUR ~ 328 000 XAF).
DEVISE_REFERENCE=EUR
NOTES_FRAIS_SEUIL_DIRECTION_FINANCIERE=500.00
# Adresse de la comptabilite qui recoit la synthese des notes de frais validees (vide : aucun e-mail envoye,
# l'ecran « Synthese des frais » reste disponible).
COMPTABILITE_EMAIL=

# --- Regles metier achats ---
# Taux de TVA applique a la ventilation HT/TVA/TTC du bon de commande (0.20 = 20 %).
TAUX_TVA_BON_DE_COMMANDE=0.20

# --- CORS (origines autorisees a appeler l'API depuis un navigateur -
# largement defensif depuis le passage au proxy Next.js, voir
# frontend/src/app/api/backend/[...path]/route.ts : le navigateur n'appelle
# plus directement cette API en temps normal) ---
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Frontend (Next.js) : session par cookies httpOnly (R23) ---
# Variables lues par le SERVEUR Next.js (pas par le navigateur). API_BASE_URL : adresse du backend.
# COOKIE_SECURE : "true" = cookies de session envoyes uniquement en HTTPS. Par defaut : true en
# production (NODE_ENV=production), false en developpement. Pour tester une image de PRODUCTION en
# HTTP local, mettre COOKIE_SECURE=false ; ne jamais le faire derriere un vrai nom de domaine.
# COOKIE_SECURE=true
